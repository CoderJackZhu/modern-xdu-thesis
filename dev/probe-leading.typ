// P1-1 验证：固定值 20 磅行距（基线距）+ 首行基线落位
//
// 机制：把行盒拆成「基线上方的 Δ」+「行间空隙 leading」，使
//   Δ + leading = 20pt  →  基线距精确 20pt
//   行盒顶 = 正文区顶 →  文字不越过上边距，且首行基线与官方一致
// Δ = (20 - 12)/2 + 0.88*12 = 14.56pt（汉字字身框在 20pt 行盒内居中）
//
// 参照：docs/格式规格.md §2.1 行间距 / §4.3 技术点 1

#set page(width: 210mm, height: 297mm, margin: (top: 30mm, bottom: 20mm, inside: 30mm, outside: 25mm))
#set text(font: ("Times New Roman", "Songti SC"), size: 12pt, lang: "zh")

#let 行距 = 20pt
#let 字号 = 12pt
#let 上伸 = (行距 - 字号) / 2 + 0.88 * 字号   // = 14.56pt
#let 行隙 = 行距 - 上伸                       // = 5.44pt

#let 正文样式(body) = {
  set text(top-edge: 上伸, bottom-edge: "baseline")
  set par(leading: 行隙, spacing: 行隙, justify: true, first-line-indent: 2em)
  body
}

